# ===================================================
# StaffSync Environment Configuration
# ===================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/staffsync
# For MongoDB Atlas (Cloud Free Tier):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/staffsync?retryWrites=true&w=majority

# JWT Secret Key (Change this to a strong random string before deploying to production!)
JWT_SECRET=staffsync-production-super-secret-jwt-key-change-this

# Client Origin (comma-separated allowed origins for CORS)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000
